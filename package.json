{
  "name": "orca-sonar",
  "version": "0.1.0",
  "private": true,
  "description": "Orca plugin: fast file and symbol lookup for agents with fewer tokens",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
