{
  "manifestVersion": 1,
  "id": "orca-sonar",
  "publisher": "ab2web",
  "name": "Sonar",
  "version": "0.2.2",
  "description": "Fast file and symbol lookup for agents, with an index kept in Orca's data folder and never inside the repository. Switch it on or off for agents, see every workspace's index and how much it saves versus grep.",
  "engines": {
    "orca": ">=1.4.160"
  },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "sonar-settings",
        "title": "Sonar",
        "icon": "icons/sonar.svg",
        "entry": "panels/settings.html",
        "surface": "settings"
      },
      {
        "id": "sonar-usage",
        "title": "Sonar",
        "icon": "icons/sonar.svg",
        "entry": "panels/usage.html",
        "surface": "nav"
      }
    ],
    "commands": [
      {
        "id": "sonar.refresh",
        "title": "Sonar: Refresh"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "worktree.created"
      }
    ],
    "skills": [
      {
        "path": "skills/orca-sonar"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "process:spawn"
    },
    {
      "kind": "storage"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "events:subscribe"
    },
    {
      "kind": "skills:contribute"
    }
  ]
}
